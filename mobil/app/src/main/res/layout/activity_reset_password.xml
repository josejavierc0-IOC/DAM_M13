<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171A19"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="IOC Padel Pass"
            android:textColor="#66BB6A"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Establir contrasenya nova"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Token de recuperació"
            android:inputType="text"
            android:minHeight="52dp"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#BBBBBB" />

        <EditText
            android:id="@+id/etPasswordNova"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Contrasenya nova"
            android:inputType="textPassword"
            android:minHeight="52dp"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#BBBBBB" />

        <EditText
            android:id="@+id/etConfirmarPasswordNova"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Repeteix la contrasenya nova"
            android:inputType="textPassword"
            android:minHeight="52dp"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#BBBBBB" />

        <Button
            android:id="@+id/btnRestablir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#66BB6A"
            android:minHeight="52dp"
            android:text="Canviar contrasenya"
            android:textColor="#171A19"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>